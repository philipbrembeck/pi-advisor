{
  "name": "pi-advisor-flow",
  "version": "0.12.0",
  "description": "Advanced Executor/Advisor flow for Pi, fully configurable and extendable.",
  "keywords": [
    "advisor",
    "herdr",
    "jev",
    "pi-advisor",
    "pi-coding-agent",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/philipbrembeck/pi-advisor",
  "license": "MIT",
  "author": "Philip Brembeck",
  "repository": {
    "type": "git",
    "url": "https://github.com/philipbrembeck/pi-advisor.git"
  },
  "files": [
    "dist",
    "extensions",
    "src",
    "scripts/check-bun-version.mjs",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "extensions/index.ts",
  "scripts": {
    "bench:decisions": "bun bench/src/cli.ts decisions",
    "bench:evaluate": "bun bench/src/cli.ts evaluate",
    "bench:replay": "bun bench/src/cli.ts replay",
    "bench:screen": "bun bench/src/cli.ts screen",
    "build": "bun build ./extensions/index.ts --outfile dist/index.js --target node --format esm --external @earendil-works/pi-ai --external @earendil-works/pi-coding-agent --external @earendil-works/pi-tui --external typebox",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "format": "oxfmt",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "bun run build >/dev/null",
    "package:check": "node scripts/check-package.mjs",
    "preinstall": "node scripts/check-bun-version.mjs",
    "prepare": "husky",
    "socket": "bunx socket optimize",
    "test": "bun test && bun run test:node-loader",
    "test:bench": "bun --config=./bunfig.bench.toml test ./bench/test/",
    "test:node-loader": "node --test test/default-resource-loader.node.mjs",
    "typecheck": "bun check",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "^26.6.5",
    "@typesafe-ai/sdk": "^0.6.0",
    "bun-types": "1.4.3",
    "husky": "^9.1.7",
    "knip": "6.41.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typebox": "^1.3.36",
    "typescript": "^7.0.2",
    "ultracite": "7.12.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "typebox": "^1.1.38"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "resolutions": {
    "is-unicode-supported": "npm:@socketregistry/is-unicode-supported@1.0.5",
    "safe-buffer": "npm:@socketregistry/safe-buffer@1.0.9"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "braces": "github:micromatch/braces#d0d575e55e74a4e0218e5248fafb79efc3e54ebb",
    "is-unicode-supported": "npm:@socketregistry/is-unicode-supported@1.0.5",
    "safe-buffer": "npm:@socketregistry/safe-buffer@1.0.9",
    "undici": "8.11.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc}": [
      "oxfmt"
    ]
  },
  "packageManager": "bun@1.4.3",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "image": "https://raw.githubusercontent.com/philipbrembeck/pi-advisor/refs/heads/main/assets/hero.png"
  }
}
