    "temperature": 0
  },
  "output": {
    "resultsPath": "benchmarks/results/runs.jsonl",
    "reportMarkdownPath": "benchmarks/results/report.md",
    "reportJsonPath": "benchmarks/results/report.json"
  },
  "provenance": { "name": "pi-advisor-flow", "version": "0.1" }
}
